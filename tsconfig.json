{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noImplicitAny": false,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/lib/*": [
        "./packages/shared-lib/src/lib/*"
      ],
      "@/types": [
        "./packages/shared-lib/src/types"
      ],
      "@/types/*": [
        "./packages/shared-lib/src/types/*"
      ],
      "@/*": [
        "./src/*"
      ],
      "@volo/shared-types": [
        "./packages/shared-types/src/index.ts"
      ],
      "@volo/shared-lib": [
        "./packages/shared-lib/src/index.ts"
      ],
      "@volo/shared-lib/*": [
        "./packages/shared-lib/src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": [
    "node_modules"
  ]
}
